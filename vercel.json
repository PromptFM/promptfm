# PromptFM — Vercel Deployment Configuration

framework = "nextjs"
buildCommand = "npm run build"
devCommand = "npm run dev"
installCommand = "npm install"
outputDirectory = ".next"

[env]
# Add all variables listed in .env.local.example to your Vercel project
# Dashboard → Settings → Environment Variables
# Mark server-only keys (SUPABASE_SERVICE_ROLE_KEY, R2_*) as non-exposed.

[build.env]
NEXT_TELEMETRY_DISABLED = "1"

