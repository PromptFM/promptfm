# ==============================================================
# PromptFM — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ==============================================================

# ── Supabase ───────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only – never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Cloudflare R2 ──────────────────────────────────────────────
# Found in: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=promptfm-audio

# Public URL for your R2 bucket (enable "Public Access" in R2 dashboard
# or configure a custom domain / Cloudflare Worker in front of the bucket)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Audio Streaming ────────────────────────────────────────────
# Your Icecast / AzuraCast mount URL, e.g.:
# https://radio.example.com/stream.mp3
NEXT_PUBLIC_STREAM_URL=https://your-icecast-server.com/stream.mp3

# ── AI DJ & Voice Engine (Google Gemini & TTS) ────────────────
# Free via Google AI Studio / Google Cloud Console
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_TTS_API_KEY=your-google-tts-key # (Optional, falls back to GEMINI_API_KEY)
CRON_SECRET=your-random-cron-secret-phrase

# ── Community Broadcast Bridges (Optional) ────────────────────
# Discord Incoming Webhook URL from Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# Telegram Bot Token & Target Chat ID from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO
TELEGRAM_CHAT_ID=-1001234567890

