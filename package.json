{
  "name": "promptfm",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:sql": "jiti scripts/lint-sql.ts",
    "lint:dns": "jiti scripts/promptfm.ts dns status promptfm.live --strict",
    "lint:tf": "terraform fmt -check -recursive infra/terraform && terraform -chdir=infra/terraform init -backend=false && terraform -chdir=infra/terraform validate && terraform fmt -check -recursive infra/terraform-resend",
    "lint:ansible": "env -u ANSIBLE_VAULT_PASSWORD_FILE ansible-playbook -i infra/ansible/inventory.ini infra/ansible/playbook.yml --syntax-check && env -u ANSIBLE_VAULT_PASSWORD_FILE ansible-playbook -i infra/ansible/inventory.ini infra/ansible/hostinger-playbook.yml --syntax-check",
    "email:forward": "jiti scripts/set-inbound-forwarding.ts",
    "infra:resend:plan": "infra/terraform-resend/run.sh plan",
    "infra:resend:apply": "infra/terraform-resend/run.sh apply",
    "lint:infra": "npm run lint:dns && npm run lint:tf && npm run lint:ansible",
    "typecheck": "tsc --noEmit",
    "promptfm": "jiti scripts/promptfm.ts",
    "db:migrate": "jiti scripts/apply-sql-migrations.ts",
    "prepare-terraform": "jiti scripts/prepare-infra.ts",
    "prepare-infra": "jiti scripts/prepare-infra.ts",
    "local:up": "docker compose -f docker-compose.local.yml up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest --changed origin/main",
    "test:related": "vitest related",
    "test:mutate": "stryker run",
    "test:mutate:affected": "jiti scripts/mutate-affected.ts",
    "generate:badges": "jiti scripts/generate-badges.ts",
    "test:speed": "jiti scripts/profile-speed.ts --strict",
    "profile:speed": "jiti scripts/profile-speed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "flags": "^4.4.0",
    "lucide-react": "^1.69.0",
    "music-metadata": "^12.3.5",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
