{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "testRunner_comment": "Uses Vitest runner plugin",
  "mutator": {
    "excludedMutations": ["Regex"]
  },
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/**/*.d.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": {
    "high": 85,
    "low": 80,
    "break": 80
  }
}
