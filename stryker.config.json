{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "testRunner_comment": "Uses Vitest runner plugin",
  "mutate": [
    "src/lib/safety/**/*.ts",
    "src/lib/dj/roster.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}

