{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "testRunner_comment": "Uses Vitest runner plugin",
  "mutator": {
    "excludedMutations": ["Regex"]
  },
  "mutate": [
    "src/lib/dj/**/*.ts",
    "src/lib/community/**/*.ts",
    "src/lib/radio/**/*.ts",
    "src/lib/guardrails/**/*.ts",
    "src/lib/legal/**/*.ts",
    "src/lib/safety/**/*.ts",
    "src/lib/ci/**/*.ts",
    "src/lib/mcp/**/*.ts",
    "src/lib/flags/**/*.ts",
    "src/lib/email/**/*.ts",
    "src/lib/infra/**/*.ts",
    "!src/lib/**/*.d.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 50
  }
}
