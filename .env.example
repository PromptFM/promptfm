# ==============================================================
# PromptFM — Local Developer Environment Configuration (.env.example)
#
# QUICKSTART (Zero Production Dependency):
#   1. cp .env.example .env.local
#   2. npm run dev
#
# All values below are pre-configured for local developer simulation.
# No production credentials, API credits, or cloud access required!
# ==============================================================

# ── Developer Simulation Mode ─────────────────────────────────
# When true, all background jobs, DJ voices, AI RAG, and social bridges
# run safely in local simulation mode with zero production side-effects.
DEV_FALLBACK_SIMULATION=true
NODE_ENV=development

# ── Local Supabase / PostgreSQL (Docker or Mock) ───────────────
# Default points to local Postgres/Supabase instance (port 54322)
# If Docker is not running, the app automatically falls back to in-memory/YAML mock data.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54322
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-dev-mock-anon-key-promptfm-2026
SUPABASE_SERVICE_ROLE_KEY=local-dev-mock-service-role-key-promptfm-2026

# ── Local Audio Streamer (Icecast Simulation) ─────────────────
# Points to local Icecast Docker container running at port 8000.
# If Docker is not running, AudioPlayer plays sample generative preview audio.
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/stream.mp3

# ── Local Object Storage (MinIO / S3 Simulation) ──────────────
# Simulates Cloudflare R2 bucket for local song uploads & cover art
R2_ACCOUNT_ID=local-minio
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=promptfm-audio
NEXT_PUBLIC_R2_PUBLIC_URL=http://localhost:9000/promptfm-audio

# ── Station Admin Studio (/admin) ─────────────────────────────
# Local development admin bypass
NEXT_PUBLIC_ADMIN_EMAILS=dev@promptfm.local,admin@promptfm.local
ADMIN_API_KEY=promptfm-local-dev-key

# ── AI DJ Engine & LLM (Simulation Mode) ──────────────────────
# Safe mock keys for Google Gemini 3.5 Flash & TTS
# Prompts and voice drops log to local console in simulation mode.
GEMINI_API_KEY=mock-gemini-api-key-local-simulation
GOOGLE_TTS_API_KEY=mock-tts-api-key-local-simulation
CRON_SECRET=local-dev-cron-secret-2026

# ── Social Broadcast Bridges (Simulation Mode) ────────────────
# Tweets, Discord webhooks, and Telegram broadcasts log cleanly
# to the terminal in DevFallback mode without hitting external APIs.
DISCORD_WEBHOOK_URL=http://localhost:9999/mock-discord-webhook
TELEGRAM_BOT_TOKEN=0000000000:LOCAL_MOCK_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=-1000000000000
X_API_KEY=mock_x_api_key
X_API_SECRET=mock_x_api_secret
X_ACCESS_TOKEN=mock_x_access_token
X_ACCESS_TOKEN_SECRET=mock_x_access_token_secret
X_CLIENT_ID=mock_x_client_id
X_CLIENT_SECRET=mock_x_client_secret

# ── Inbound Email & Webhooks (Simulation Mode) ────────────────
RESEND_API_KEY=mock_resend_api_key_local_dev
RESEND_WEBHOOK_SECRET=mock_local_webhook_secret
