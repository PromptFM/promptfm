version: "3.9"

services:
  web:
    image: {{ promptfm_web_image_ref }}
    container_name: promptfm-web-{{ promptfm_web_release_id }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      HOSTNAME: 0.0.0.0
      PORT: "{{ promptfm_web_container_port }}"
      PROMPTFM_STATUS_STREAM_URL: "{{ promptfm_web_status_stream_url }}"
      NEXT_PUBLIC_SUPABASE_URL: "{{ promptfm_web_supabase_url }}"
{% if (promptfm_web_supabase_anon_key | default('') | length) > 0 %}
      NEXT_PUBLIC_SUPABASE_ANON_KEY: "{{ promptfm_web_supabase_anon_key }}"
{% endif %}
      SUPABASE_SERVICE_ROLE_KEY: "{{ promptfm_web_supabase_service_role_key }}"
    ports:
      - "127.0.0.1:{{ promptfm_web_release_host_port }}:{{ promptfm_web_container_port }}"
    networks:
      - oracle_edge

networks:
  oracle_edge:
    external: true
    name: {{ promptfm_streamer_docker_network }}
