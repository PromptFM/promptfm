{% set cloudflare_tunnel_token_effective = cloudflare_tunnel_token | default(lookup('env', 'CLOUDFLARE_TUNNEL_TOKEN'), true) | default('', true) %}
version: '3.8'

services:
  # 1. Icecast 2 Audio Distribution Server (Bound strictly to localhost to prevent direct VM egress)
  icecast:
    image: libretime/icecast:2.4.4
    container_name: promptfm-icecast
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ icecast_port | default(8000) }}:8000"
    entrypoint: ["icecast", "-c", "/etc/icecast.xml"]
    environment:
      - ICECAST_SOURCE_PASSWORD={{ icecast_source_password }}
      - ICECAST_ADMIN_PASSWORD={{ icecast_admin_password }}
      - ICECAST_PASSWORD=promptfm_hackme_2026
    volumes:
      - ./icecast.xml:/etc/icecast.xml:ro

  # 2. Liquidsoap Radio Automation & Dynamic DJ Mixer
  liquidsoap:
    image: savonet/liquidsoap:v2.2.5
    container_name: promptfm-liquidsoap
    restart: unless-stopped
    depends_on:
      - icecast
    volumes:
      - ./radio.liq:/etc/liquidsoap/radio.liq:ro
      - ./radio-standby.liq:/etc/liquidsoap/radio-standby.liq:ro
      - ./fallback.mp3:/etc/liquidsoap/fallback.mp3:ro
    command: ["liquidsoap", "/etc/liquidsoap/{{ liquidsoap_script | default('radio.liq') }}"]

{% if cloudflare_tunnel_token_effective %}
  # 3. Cloudflare Tunnel (only rendered when a tunnel token is set; every listener byte still leaves the VM)
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: promptfm-tunnel
    restart: unless-stopped
    environment:
      - TUNNEL_TOKEN={{ cloudflare_tunnel_token_effective }}
    command: tunnel --no-autoupdate run
    depends_on:
      - icecast

{% endif %}
  # 4. Caddy Automatic HTTPS Reverse Proxy (loopback by default; set caddy_bind_address=0.0.0.0 to serve the public)
  caddy:
    image: caddy:2-alpine
    container_name: promptfm-caddy
    restart: unless-stopped
    ports:
      - "{{ caddy_bind_address | default('127.0.0.1') }}:{{ caddy_http_port | default(80) }}:80"
      - "{{ caddy_bind_address | default('127.0.0.1') }}:{{ caddy_https_port | default(443) }}:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./maintenance:/srv/maintenance:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - icecast

volumes:
  caddy_data:
  caddy_config:
