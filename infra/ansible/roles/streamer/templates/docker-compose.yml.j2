version: '3.8'

services:
  # 1. Icecast 2 Audio Distribution Server (Bound strictly to localhost to prevent direct VM egress)
  icecast:
    image: infiniteproject/icecast:latest
    container_name: promptfm-icecast
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ icecast_port | default(8000) }}:8000"
    entrypoint: ["icecast", "-c", "/etc/icecast.xml"]
    environment:
      - ICECAST_SOURCE_PASSWORD={{ icecast_source_password }}
      - ICECAST_ADMIN_PASSWORD={{ icecast_admin_password }}
      - ICECAST_PASSWORD=promptfm_hackme_2026
    volumes:
      - ./icecast.xml:/etc/icecast.xml:ro

  # 2. Liquidsoap Radio Automation & Dynamic DJ Mixer
  liquidsoap:
    image: savonet/liquidsoap:v2.2.5
    container_name: promptfm-liquidsoap
    restart: unless-stopped
    depends_on:
      - icecast
    volumes:
      - ./radio.liq:/etc/liquidsoap/radio.liq:ro
      - ./fallback.mp3:/etc/liquidsoap/fallback.mp3:ro
    command: ["liquidsoap", "/etc/liquidsoap/radio.liq"]

  # 3. Cloudflare Tunnel (Free Zero-Egress Proxy to Edge CDN)
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: promptfm-tunnel
    restart: unless-stopped
    environment:
      - TUNNEL_TOKEN={{ cloudflare_tunnel_token | default(lookup('env', 'CLOUDFLARE_TUNNEL_TOKEN') | default('', true)) }}
    command: tunnel --no-autoupdate run
    depends_on:
      - icecast

  # 4. Caddy Automatic HTTPS Reverse Proxy (Internal loopback only; direct public ingress closed)
  caddy:
    image: caddy:2-alpine
    container_name: promptfm-caddy
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ caddy_http_port | default(80) }}:80"
      - "127.0.0.1:{{ caddy_https_port | default(443) }}:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - icecast

volumes:
  caddy_data:
  caddy_config:
